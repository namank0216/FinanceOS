+name: crypto-refresh
+on:
+  schedule:
+    - cron: "15 13 * * *"     # 13:15 UTC daily (after Coin Metrics' morning update)
+  workflow_dispatch:
+jobs:
+  refresh:
+    runs-on: ubuntu-latest
+    permissions: { contents: write }
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: { python-version: "3.11" }
+      - run: pip install -r stocks_portal/requirements.txt
+      - run: cd stocks_portal && python scripts/refresh_crypto.py
+        env:
+          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+      - name: Commit snapshot
+        run: |
+          git config user.name "pulsefi-bot" && git config user.email "bot@users.noreply.github.com"
+          git add stocks_portal/.cache/crypto_state.json stocks_portal/.cache/crypto_state_history.jsonl stocks_portal/.cache/last_refresh.json
+          git diff --cached --quiet || git commit -m "crypto snapshot $(date -u +%F)" && git push
